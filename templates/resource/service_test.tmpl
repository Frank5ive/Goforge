func TestInputValidateRules(t *testing.T) {
	if err := validInput().Validate(); err != nil {
		t.Fatalf("validInput().Validate() = %v, want nil", err)
	}

	tests := []struct {
		name string
		edit func(*Input)
	}{
{{- range .InvalidCases}}
		{ {{- .Name}}, func(in *Input) { in.{{.Field}} = {{.Value}} }},
{{- end}}
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			in := validInput()
			tt.edit(&in)
			if err := in.Validate(); err == nil {
				t.Errorf("Validate() = nil, want an error")
			}
		})
	}
}
{{- end}}

func TestServiceUpdate(t *testing.T) {
	svc := newTestService()
	created, err := svc.Create(t.Context(), validInput())
	if err != nil {
		t.Fatalf("Create() error = %v", err)
	}

	updated, err := svc.Update(t.Context(), created.ID, updatedInput())
	if err != nil {
		t.Fatalf("Update() error = %v", err)
	}

	want := created
	want.apply(updatedInput())
	want.UpdatedAt = updated.UpdatedAt
	if updated != want {
		t.Errorf("Update() = %+v, want %+v", updated, want)
	}
	if !updated.UpdatedAt.After(created.UpdatedAt) {
		t.Errorf("UpdatedAt = %v, want it after %v", updated.UpdatedAt, created.UpdatedAt)
	}
}

func TestServicePatchChangesOnlySentFields(t *testing.T) {
	svc := newTestService()
	created, err := svc.Create(t.Context(), validInput())
	if err != nil {
		t.Fatalf("Create() error = %v", err)
	}

	patched, err := svc.Patch(t.Context(), created.ID, Patch{ {{- .First.GoName}}: ptr({{.First.Updated}})})
	if err != nil {
		t.Fatalf("Patch() error = %v", err)
	}

	want := created
	want.{{.First.GoName}} = {{.First.Updated}}
	want.UpdatedAt = patched.UpdatedAt
	if patched != want {
		t.Errorf("Patch() = %+v, want %+v", patched, want)
	}
}
