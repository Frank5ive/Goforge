func TestServiceDelete(t *testing.T) {
	svc := newTestService()
	created, err := svc.Create(t.Context(), validInput())
	if err != nil {
		t.Fatalf("Create() error = %v", err)
	}

	if err := svc.Delete(t.Context(), created.ID); err != nil {
		t.Fatalf("Delete() error = %v", err)
	}
	if _, err := svc.Get(t.Context(), created.ID); !errors.Is(err, ErrNotFound) {
		t.Errorf("Get() after Delete() error = %v, want ErrNotFound", err)
	}
}

func TestServiceListPaginates(t *testing.T) {
	svc := newTestService()
	var ids []string
	for range 3 {
		item, err := svc.Create(t.Context(), validInput())
		if err != nil {
			t.Fatalf("Create() error = %v", err)
		}
		ids = append(ids, item.ID)
	}

	tests := []struct {
		name              string
		limit, offset     int
		wantIDs           []string
		wantLimit, wantTotal int
	}{
		{"default limit", 0, 0, ids, DefaultLimit, 3},
		{"first page", 2, 0, ids[:2], 2, 3},
		{"second page", 2, 2, ids[2:], 2, 3},
		{"past the end", 2, 5, nil, 2, 3},
		{"limit capped", MaxLimit + 50, 0, ids, MaxLimit, 3},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			page, err := svc.List(t.Context(), tt.limit, tt.offset)
			if err != nil {
				t.Fatalf("List() error = %v", err)
			}
			if page.Total != tt.wantTotal || page.Limit != tt.wantLimit || page.Offset != tt.offset {
				t.Errorf("List() total/limit/offset = %d/%d/%d, want %d/%d/%d",
					page.Total, page.Limit, page.Offset, tt.wantTotal, tt.wantLimit, tt.offset)
			}
			if len(page.Items) != len(tt.wantIDs) {
				t.Fatalf("List() returned %d items, want %d", len(page.Items), len(tt.wantIDs))
			}
			for i, item := range page.Items {
				if item.ID != tt.wantIDs[i] {
					t.Errorf("item %d = %s, want %s (oldest first)", i, item.ID, tt.wantIDs[i])
				}
			}
		})
	}

	if _, err := svc.List(t.Context(), -1, 0); !errors.Is(err, ErrInvalid) {
		t.Errorf("List(negative limit) error = %v, want ErrInvalid", err)
	}
}

func TestServiceNotFound(t *testing.T) {
	svc := newTestService()

	if _, err := svc.Get(t.Context(), "missing"); !errors.Is(err, ErrNotFound) {
		t.Errorf("Get() error = %v, want ErrNotFound", err)
	}
	if _, err := svc.Update(t.Context(), "missing", validInput()); !errors.Is(err, ErrNotFound) {
		t.Errorf("Update() error = %v, want ErrNotFound", err)
	}
	if _, err := svc.Patch(t.Context(), "missing", Patch{}); !errors.Is(err, ErrNotFound) {
		t.Errorf("Patch() error = %v, want ErrNotFound", err)
	}
	if err := svc.Delete(t.Context(), "missing"); !errors.Is(err, ErrNotFound) {
		t.Errorf("Delete() error = %v, want ErrNotFound", err)
	}
}
