const (
	validBody   = `{ {{- range $i, $f := .Fields}}{{if $i}}, {{end}}"{{$f.JSON}}": {{$f.SampleJSON}}{{end -}} }`
	updatedBody = `{ {{- range $i, $f := .Fields}}{{if $i}}, {{end}}"{{$f.JSON}}": {{$f.UpdatedJSON}}{{end -}} }`
	patchBody   = `{"{{.First.JSON}}": {{.First.UpdatedJSON}}}`
)

// newTestMux returns a mux with the {{.Human}} routes backed by an in-memory repository.
func newTestMux() *http.ServeMux {
	mux := http.NewServeMux()
	RegisterRoutes(mux, NewService(NewMemoryRepository()))
	return mux
}

// do sends a request to h and returns the recorded response.
func do(t *testing.T, h http.Handler, method, path, body string) *httptest.ResponseRecorder {
	t.Helper()

	req := httptest.NewRequestWithContext(t.Context(), method, path, strings.NewReader(body))
	rec := httptest.NewRecorder()
	h.ServeHTTP(rec, req)
	return rec
}

func TestHandlerCRUD(t *testing.T) {
	mux := newTestMux()

	rec := do(t, mux, http.MethodPost, "{{.Path}}", validBody)
	if rec.Code != http.StatusCreated {
		t.Fatalf("POST {{.Path}} = %d, want %d: %s", rec.Code, http.StatusCreated, rec.Body)
	}
	var created {{.Type}}
	if err := json.NewDecoder(rec.Body).Decode(&created); err != nil {
		t.Fatalf("decoding created {{.Human}}: %v", err)
	}
	location := "{{.Path}}/" + created.ID
	if got := rec.Header().Get("Location"); got != location {
		t.Errorf("Location = %q, want %q", got, location)
	}

	if rec := do(t, mux, http.MethodGet, location, ""); rec.Code != http.StatusOK {
		t.Errorf("GET %s = %d, want %d", location, rec.Code, http.StatusOK)
	}

	rec = do(t, mux, http.MethodGet, "{{.Path}}?limit=10", "")
	var page Page
	if err := json.NewDecoder(rec.Body).Decode(&page); err != nil || len(page.Items) != 1 || page.Total != 1 || page.Limit != 10 {
		t.Errorf("GET {{.Path}} = %d %+v, want one {{.Human}} with limit 10 (decode error: %v)", rec.Code, page, err)
	}

	if rec := do(t, mux, http.MethodPut, location, updatedBody); rec.Code != http.StatusOK {
		t.Errorf("PUT %s = %d, want %d: %s", location, rec.Code, http.StatusOK, rec.Body)
	}

	if rec := do(t, mux, http.MethodPatch, location, patchBody); rec.Code != http.StatusOK {
		t.Errorf("PATCH %s = %d, want %d: %s", location, rec.Code, http.StatusOK, rec.Body)
	}

	if rec := do(t, mux, http.MethodDelete, location, ""); rec.Code != http.StatusNoContent {
		t.Errorf("DELETE %s = %d, want %d", location, rec.Code, http.StatusNoContent)
	}
	if rec := do(t, mux, http.MethodGet, location, ""); rec.Code != http.StatusNotFound {
		t.Errorf("GET %s after DELETE = %d, want %d", location, rec.Code, http.StatusNotFound)
	}
}

func TestHandlerErrors(t *testing.T) {
	tests := []struct {
		name   string
		method string
		path   string
		body   string
		want   int
	}{
		{"malformed JSON", http.MethodPost, "{{.Path}}", `{`, http.StatusBadRequest},
		{"unknown field", http.MethodPost, "{{.Path}}", `{"not_a_field": 1}`, http.StatusBadRequest},
{{- if .RequiredField}}
		{"failed validation", http.MethodPost, "{{.Path}}", `{}`, http.StatusUnprocessableEntity},
{{- end}}
		{"limit not a number", http.MethodGet, "{{.Path}}?limit=ten", "", http.StatusBadRequest},
		{"negative offset", http.MethodGet, "{{.Path}}?offset=-1", "", http.StatusBadRequest},
		{"get missing", http.MethodGet, "{{.Path}}/missing", "", http.StatusNotFound},
		{"update missing", http.MethodPut, "{{.Path}}/missing", validBody, http.StatusNotFound},
		{"patch missing", http.MethodPatch, "{{.Path}}/missing", patchBody, http.StatusNotFound},
		{"patch unknown field", http.MethodPatch, "{{.Path}}/missing", `{"not_a_field": 1}`, http.StatusBadRequest},
		{"delete missing", http.MethodDelete, "{{.Path}}/missing", "", http.StatusNotFound},
	}

	mux := newTestMux()
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			if rec := do(t, mux, tt.method, tt.path, tt.body); rec.Code != tt.want {
				t.Errorf("%s %s = %d, want %d: %s", tt.method, tt.path, rec.Code, tt.want, rec.Body)
			}
		})
	}
}

var errDatabaseDown = errors.New("database is down")

// failingRepository fails every call, like a database that is down.
type failingRepository struct{}

func (failingRepository) List(context.Context, int, int) ([]{{.Type}}, int, error) {
	return nil, 0, errDatabaseDown
}
func (failingRepository) Get(context.Context, string) ({{.Type}}, error) {
	return {{.Type}}{}, errDatabaseDown
}
func (failingRepository) Create(context.Context, {{.Type}}) error { return errDatabaseDown }
func (failingRepository) Update(context.Context, {{.Type}}) error { return errDatabaseDown }
func (failingRepository) Delete(context.Context, string) error { return errDatabaseDown }

func TestHandlerUnexpectedErrors(t *testing.T) {
	mux := http.NewServeMux()
	RegisterRoutes(mux, NewService(failingRepository{}))

	for _, development := range []bool{false, true} {
		var logs bytes.Buffer
		ctx := handlers.WithRequest(t.Context(), slog.New(slog.NewTextHandler(&logs, nil)), development)
		req := httptest.NewRequestWithContext(ctx, http.MethodGet, "{{.Path}}/some-id", nil)
		rec := httptest.NewRecorder()
		rec.Header().Set(handlers.RequestIDHeader, "req-1") // set by the server's middleware
		mux.ServeHTTP(rec, req)

		var body handlers.ErrorResponse
		if err := json.NewDecoder(rec.Body).Decode(&body); err != nil {
			t.Fatalf("decoding body: %v", err)
		}
		if rec.Code != http.StatusInternalServerError || body.Error != "internal server error" || body.RequestID != "req-1" {
			t.Errorf("got %d %+v, want 500 with a generic error and the request ID", rec.Code, body)
		}

		// The cause is always logged, and only shown to clients in development
		if !strings.Contains(logs.String(), errDatabaseDown.Error()) {
			t.Errorf("the cause of the 500 was not logged: %s", logs.String())
		}
		wantDetail := ""
		if development {
			wantDetail = errDatabaseDown.Error()
		}
		if body.Detail != wantDetail {
			t.Errorf("development=%t: detail = %q, want %q", development, body.Detail, wantDetail)
		}
	}
}
