package {{.Package}}

import (
	"encoding/json"
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"
)

const (
	validBody   = `{ {{- range $i, $f := .Fields}}{{if $i}}, {{end}}"{{$f.JSON}}": {{$f.SampleJSON}}{{end -}} }`
	updatedBody = `{ {{- range $i, $f := .Fields}}{{if $i}}, {{end}}"{{$f.JSON}}": {{$f.UpdatedJSON}}{{end -}} }`
)

// newTestMux returns a mux with the {{.Human}} routes backed by an in-memory repository.
func newTestMux() *http.ServeMux {
	mux := http.NewServeMux()
	RegisterRoutes(mux, NewService(NewMemoryRepository()))
	return mux
}

// do sends a request to h and returns the recorded response.
func do(t *testing.T, h http.Handler, method, path, body string) *httptest.ResponseRecorder {
	t.Helper()

	req := httptest.NewRequestWithContext(t.Context(), method, path, strings.NewReader(body))
	rec := httptest.NewRecorder()
	h.ServeHTTP(rec, req)
	return rec
}

func TestHandlerCRUD(t *testing.T) {
	mux := newTestMux()

	rec := do(t, mux, http.MethodPost, "{{.Path}}", validBody)
	if rec.Code != http.StatusCreated {
		t.Fatalf("POST {{.Path}} = %d, want %d: %s", rec.Code, http.StatusCreated, rec.Body)
	}
	var created {{.Type}}
	if err := json.NewDecoder(rec.Body).Decode(&created); err != nil {
		t.Fatalf("decoding created {{.Human}}: %v", err)
	}
	location := "{{.Path}}/" + created.ID
	if got := rec.Header().Get("Location"); got != location {
		t.Errorf("Location = %q, want %q", got, location)
	}

	if rec := do(t, mux, http.MethodGet, location, ""); rec.Code != http.StatusOK {
		t.Errorf("GET %s = %d, want %d", location, rec.Code, http.StatusOK)
	}

	rec = do(t, mux, http.MethodGet, "{{.Path}}", "")
	var list []{{.Type}}
	if err := json.NewDecoder(rec.Body).Decode(&list); err != nil || len(list) != 1 {
		t.Errorf("GET {{.Path}} = %d %v, want one {{.Human}} (decode error: %v)", rec.Code, list, err)
	}

	if rec := do(t, mux, http.MethodPut, location, updatedBody); rec.Code != http.StatusOK {
		t.Errorf("PUT %s = %d, want %d: %s", location, rec.Code, http.StatusOK, rec.Body)
	}

	if rec := do(t, mux, http.MethodDelete, location, ""); rec.Code != http.StatusNoContent {
		t.Errorf("DELETE %s = %d, want %d", location, rec.Code, http.StatusNoContent)
	}
	if rec := do(t, mux, http.MethodGet, location, ""); rec.Code != http.StatusNotFound {
		t.Errorf("GET %s after DELETE = %d, want %d", location, rec.Code, http.StatusNotFound)
	}
}

func TestHandlerErrors(t *testing.T) {
	tests := []struct {
		name   string
		method string
		path   string
		body   string
		want   int
	}{
		{"malformed JSON", http.MethodPost, "{{.Path}}", `{`, http.StatusBadRequest},
		{"unknown field", http.MethodPost, "{{.Path}}", `{"not_a_field": 1}`, http.StatusBadRequest},
{{- if .HasRequired}}
		{"failed validation", http.MethodPost, "{{.Path}}", `{}`, http.StatusUnprocessableEntity},
{{- end}}
		{"get missing", http.MethodGet, "{{.Path}}/missing", "", http.StatusNotFound},
		{"update missing", http.MethodPut, "{{.Path}}/missing", validBody, http.StatusNotFound},
		{"delete missing", http.MethodDelete, "{{.Path}}/missing", "", http.StatusNotFound},
	}

	mux := newTestMux()
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			if rec := do(t, mux, tt.method, tt.path, tt.body); rec.Code != tt.want {
				t.Errorf("%s %s = %d, want %d: %s", tt.method, tt.path, rec.Code, tt.want, rec.Body)
			}
		})
	}
}
