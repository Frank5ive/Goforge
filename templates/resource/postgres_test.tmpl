package {{.Package}}

import (
	"testing"

	"{{.Module}}/db/dbtest"
)

// TestPostgresRepository runs the shared repository tests against PostgreSQL.
// It is skipped unless TEST_DATABASE_URL is set; `make test-db` sets it.
func TestPostgresRepository(t *testing.T) {
	pool := dbtest.Pool(t)

	testRepository(t, func(t *testing.T) Repository {
		if _, err := pool.Exec(t.Context(), `TRUNCATE {{.Table}}`); err != nil {
			t.Fatalf("clearing the {{.TableName}} table: %v", err)
		}
		return NewPostgresRepository(pool)
	})
}
