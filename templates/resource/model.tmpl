func (item {{.Type}}) input() Input {
	return Input{
{{- range .Fields}}
		{{.GoName}}: item.{{.GoName}},
{{- end}}
	}
}

// Patch holds the fields to change in a partial update. Fields left out of the
// request, or sent as null, keep their current value.
type Patch struct {
{{- range .Fields}}
	{{.GoName}} *{{.GoType}} `json:"{{.JSON}}"`
{{- end}}
}

// applyTo copies the fields that are set in p onto in.
func (p Patch) applyTo(in *Input) {
{{- range .Fields}}
	if p.{{.GoName}} != nil {
		in.{{.GoName}} = *p.{{.GoName}}
	}
{{- end}}
}

