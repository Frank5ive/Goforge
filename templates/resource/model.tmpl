{{- end}}{{end}}

	if len(problems) > 0 {
		return errors.New(strings.Join(problems, "; "))
	}
	return nil
{{- else}}
	// Add business rules here; return an error describing every invalid field.
	return nil
{{- end}}
}

// apply copies the editable fields from in.
func (item *{{.Type}}) apply(in Input) {
{{- range .Fields}}
	item.{{.GoName}} = in.{{.GoName}}
{{- end}}
}

// input returns the editable fields of item, so partial updates can be validated
