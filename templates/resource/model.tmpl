// Input holds the client-editable fields of a {{.Type}}, used to create one or
// replace one's fields.
type Input struct {
{{- range .Fields}}
	{{.GoName}} {{.GoType}} `json:"{{.JSON}}"`
{{- end}}
}

// Validate checks the rules for a {{.Human}} and reports every problem at once:
// the field rules generated from --fields, then the custom ones in rules.go.
func (in Input) Validate() error {
	var problems []string
{{- range .Fields}}{{range .Checks}}
	if {{.Cond}} {
		problems = append(problems, {{.Message}})
	}
{{- end}}{{end}}
	problems = append(problems, in.rules()...)

	if len(problems) > 0 {
		return errors.New(strings.Join(problems, "; "))
	}
	return nil
}
{{- if .UsesEmail}}

// validEmail reports whether s has exactly one @ with text on both sides.
func validEmail(s string) bool {
	user, domain, ok := strings.Cut(s, "@")
	return ok && user != "" && domain != "" && !strings.Contains(domain, "@")
}
{{- end}}

// apply copies the editable fields from in.
func (item *{{.Type}}) apply(in Input) {
{{- range .Fields}}
	item.{{.GoName}} = in.{{.GoName}}
{{- end}}
}

// input returns the editable fields of item, so partial updates can be validated
// with the same rules as full ones.
func (item {{.Type}}) input() Input {
	return Input{
{{- range .Fields}}
		{{.GoName}}: item.{{.GoName}},
{{- end}}
	}
}

// Patch holds the fields to change in a partial update. Fields left out of the
// request, or sent as null, keep their current value.
type Patch struct {
{{- range .Fields}}
	{{.GoName}} *{{.GoType}} `json:"{{.JSON}}"`
{{- end}}
}

// applyTo copies the fields that are set in p onto in.
func (p Patch) applyTo(in *Input) {
{{- range .Fields}}
	if p.{{.GoName}} != nil {
		in.{{.GoName}} = *p.{{.GoName}}
	}
{{- end}}
}

