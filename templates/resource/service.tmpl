// check validates in, then checks its references to other resources.
func (s *Service) check({{if .Refs}}ctx{{else}}_{{end}} context.Context, in Input) error {
	if err := in.Validate(); err != nil {
		return fmt.Errorf("%w: %w", ErrInvalid, err)
	}
{{- range .Refs}}
	if s.{{.ExistsVar}} != nil{{if .Optional}} && in.{{.GoName}} != ""{{end}} {
		ok, err := s.{{.ExistsVar}}(ctx, in.{{.GoName}})
		if err != nil {
			return err
		}
		if !ok {
			return fmt.Errorf("%w: {{.JSON}} is not the ID of an existing {{.TargetHuman}}", ErrInvalid)
		}
	}
{{- end}}
	return nil
}

// Create validates in and stores a new {{.Human}}.
func (s *Service) Create(ctx context.Context, in Input) ({{.Type}}, error) {
	if err := s.check(ctx, in); err != nil {
		return {{.Type}}{}, err
	}

	now := s.now()
	item := {{.Type}}{ID: newID(), CreatedAt: now, UpdatedAt: now}
	item.apply(in)

	if err := s.repo.Create(ctx, item); err != nil {
		return {{.Type}}{}, err
	}
	return item, nil
}

// Update validates in and replaces the fields of the {{.Human}} with the given ID.
func (s *Service) Update(ctx context.Context, id string, in Input) ({{.Type}}, error) {
	if err := s.check(ctx, in); err != nil {
		return {{.Type}}{}, err
	}

	item, err := s.repo.Get(ctx, id)
	if err != nil {
		return {{.Type}}{}, err
	}
	item.apply(in)
	item.UpdatedAt = s.now()

	if err := s.repo.Update(ctx, item); err != nil {
		return {{.Type}}{}, err
	}
	return item, nil
}

// Patch changes only the fields set in p on the {{.Human}} with the given ID. The
// result is validated with the same rules as Create and Update.
func (s *Service) Patch(ctx context.Context, id string, p Patch) ({{.Type}}, error) {
	item, err := s.repo.Get(ctx, id)
	if err != nil {
		return {{.Type}}{}, err
	}

	in := item.input()
	p.applyTo(&in)
	if err := s.check(ctx, in); err != nil {
		return {{.Type}}{}, err
	}
	item.apply(in)
	item.UpdatedAt = s.now()

	if err := s.repo.Update(ctx, item); err != nil {
		return {{.Type}}{}, err
	}
	return item, nil
}

// Delete removes the {{.Human}} with the given ID, unless other items still
// refer to it (ErrInUse).
func (s *Service) Delete(ctx context.Context, id string) error {
	for _, c := range s.deleteChecks {
		inUse, err := c.inUse(ctx, id)
		if err != nil {
			return err
		}
		if inUse {
			return fmt.Errorf("%w: %s still refer to it", ErrInUse, c.what)
		}
	}
	return s.repo.Delete(ctx, id)
}

// newID returns a random 128-bit ID encoded as 32 hex characters.
func newID() string {
	b := make([]byte, 16)
	_, _ = rand.Read(b)
	return hex.EncodeToString(b)
}
