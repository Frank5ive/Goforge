// deleteCheck reports whether items named by what still refer to a {{.Human}}.
type deleteCheck struct {
	what  string
	inUse func(ctx context.Context, id string) (bool, error)
}

// NewService returns a Service that stores {{.HumanPlural}} in repo.
func NewService(repo Repository) *Service {
	return &Service{repo: repo, now: increasingClock()}
}

// increasingClock returns a clock with millisecond precision, which every
// supported database stores (MongoDB keeps milliseconds), so values read back
// match the ones returned. Each time it returns is later than the one before,
// so {{.HumanPlural}} created in the same millisecond still list in the order
// they were created.
func increasingClock() func() time.Time {
	var mu sync.Mutex
	var last time.Time
	return func() time.Time {
		mu.Lock()
		defer mu.Unlock()
		now := time.Now().UTC().Truncate(time.Millisecond)
		if !now.After(last) {
			now = last.Add(time.Millisecond)
		}
		last = now
		return now
	}
}

// Pagination limits for List.
const (
	DefaultLimit = 20
	MaxLimit     = 100
)

// List returns one page of {{.HumanPlural}}, oldest first. A limit of 0 means
// DefaultLimit, and limits above MaxLimit are capped.
func (s *Service) List(ctx context.Context, limit, offset int) (Page, error) {
	if limit < 0 || offset < 0 {
		return Page{}, fmt.Errorf("%w: limit and offset must not be negative", ErrInvalid)
	}
	if limit == 0 {
		limit = DefaultLimit
	}
	limit = min(limit, MaxLimit)

	items, total, err := s.repo.List(ctx, limit, offset)
	if err != nil {
		return Page{}, err
	}
	return Page{Items: items, Total: total, Limit: limit, Offset: offset}, nil
}

// Get returns the {{.Human}} with the given ID.
func (s *Service) Get(ctx context.Context, id string) ({{.Type}}, error) {
	return s.repo.Get(ctx, id)
}

// Exists reports whether a {{.Human}} with the ID exists. Resources that refer
// to {{.HumanPlural}} use it to check their references.
func (s *Service) Exists(ctx context.Context, id string) (bool, error) {
	_, err := s.repo.Get(ctx, id)
	if errors.Is(err, ErrNotFound) {
		return false, nil
	}
	return err == nil, err
}

// BlockDeleteWhen makes Delete fail with ErrInUse while inUse reports that
// other items, named by what (e.g. "orders"), still refer to the {{.Human}}.
// server/routes.go wires it for each resource that refers to {{.HumanPlural}}.
func (s *Service) BlockDeleteWhen(what string, inUse func(ctx context.Context, id string) (bool, error)) {
	s.deleteChecks = append(s.deleteChecks, deleteCheck{what: what, inUse: inUse})
}
