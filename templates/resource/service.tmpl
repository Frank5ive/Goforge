// Has{{.GoName}} reports whether any {{$.Human}} has the {{.JSON}} id, so the
// {{.TargetHuman}} can't be deleted while one does.
func (s *Service) Has{{.GoName}}(ctx context.Context, id string) (bool, error) {
	n, err := s.repo.CountBy{{.GoName}}(ctx, id)
	return n > 0, err
}
