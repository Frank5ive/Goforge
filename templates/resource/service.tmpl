// Service implements the {{.Human}} use cases on top of a Repository. Business
// logic belongs here, not in the handlers or the repository.
type Service struct {
	repo Repository
	now  func() time.Time
	// deleteChecks stop Delete while other items refer to a {{.Human}}; see BlockDeleteWhen
	deleteChecks []deleteCheck
{{- range .Refs}}
	// {{.ExistsVar}} checks {{.JSON}}; see Require{{.GoName}}
	{{.ExistsVar}} func(context.Context, string) (bool, error)
{{- end}}
