package {{.Package}}

import (
	"cmp"
	"context"
	"slices"
	"sync"
)

// MemoryRepository is a Repository that keeps {{.HumanPlural}} in memory. It is safe
// for concurrent use, but data is lost on restart: use it for prototyping and
// tests, and replace it with a database-backed Repository for production.
type MemoryRepository struct {
	mu    sync.RWMutex
	items map[string]{{.Type}}
}

// NewMemoryRepository returns an empty MemoryRepository.
func NewMemoryRepository() *MemoryRepository {
	return &MemoryRepository{items: make(map[string]{{.Type}})}
}

// List returns up to limit {{.HumanPlural}} starting at offset, oldest first, and
// the total number stored.
func (r *MemoryRepository) List(_ context.Context, limit, offset int) ([]{{.Type}}, int, error) {
	r.mu.RLock()
	defer r.mu.RUnlock()

	items := make([]{{.Type}}, 0, len(r.items))
	for _, item := range r.items {
		items = append(items, item)
	}
	slices.SortFunc(items, func(a, b {{.Type}}) int {
		if c := a.CreatedAt.Compare(b.CreatedAt); c != 0 {
			return c
		}
		return cmp.Compare(a.ID, b.ID)
	})

	total := len(items)
	if offset >= total {
		return []{{.Type}}{}, total, nil
	}
	return items[offset:min(offset+limit, total)], total, nil
}

// Get returns the {{.Human}} with the given ID, or ErrNotFound.
func (r *MemoryRepository) Get(_ context.Context, id string) ({{.Type}}, error) {
	r.mu.RLock()
	defer r.mu.RUnlock()

	item, ok := r.items[id]
	if !ok {
		return {{.Type}}{}, ErrNotFound
	}
	return item, nil
}

// Create stores a new {{.Human}}.
func (r *MemoryRepository) Create(_ context.Context, item {{.Type}}) error {
	r.mu.Lock()
	defer r.mu.Unlock()

	r.items[item.ID] = item
	return nil
}

// Update replaces an existing {{.Human}}, or returns ErrNotFound.
func (r *MemoryRepository) Update(_ context.Context, item {{.Type}}) error {
	r.mu.Lock()
	defer r.mu.Unlock()

	if _, ok := r.items[item.ID]; !ok {
		return ErrNotFound
	}
	r.items[item.ID] = item
	return nil
}

// Delete removes the {{.Human}} with the given ID, or returns ErrNotFound.
func (r *MemoryRepository) Delete(_ context.Context, id string) error {
	r.mu.Lock()
	defer r.mu.Unlock()

	if _, ok := r.items[id]; !ok {
		return ErrNotFound
	}
	delete(r.items, id)
	return nil
}
