// Package server wires routes and middleware into an HTTP server with graceful shutdown.
package server

import (
	"context"
	"errors"
	"fmt"
	"log/slog"
	"net/http"
	"time"

	"{{.GetModuleName}}/config"
)

// Server is the HTTP server for {{.AppName}}.
type Server struct {
	httpServer *http.Server
}

// New creates a Server for cfg, with all routes and middleware registered.
func New(cfg config.Config, deps Deps, log *slog.Logger) *Server {
	return &Server{
		httpServer: &http.Server{
			Addr:              fmt.Sprintf(":%d", cfg.Port),
			Handler:           newHandler(cfg, deps, log),
			ReadHeaderTimeout: 5 * time.Second,
			ReadTimeout:       15 * time.Second,
			WriteTimeout:      15 * time.Second,
			IdleTimeout:       60 * time.Second,
		},
	}
}

// newHandler builds the router and wraps it in middleware.
// Middleware applied last runs first, so requests flow:
// requestID → cors (if configured) → recovery → limitBody{{if .IncludeLogger}} → logging{{end}} → router.
func newHandler(cfg config.Config, deps Deps, log *slog.Logger) http.Handler {
	mux := http.NewServeMux()
	registerRoutes(mux, deps)

	var handler http.Handler = mux
{{- if .IncludeLogger}}
	handler = logging(handler)
{{- end}}
	handler = limitBody(handler, cfg.MaxBodyBytes)
	handler = recovery(handler)
	if len(cfg.CORSAllowedOrigins) > 0 {
		handler = cors(handler, cfg.CORSAllowedOrigins)
	}
	handler = requestID(handler, log, cfg.Environment == config.Development)

	return handler
}

// Start listens for HTTP requests until the server is shut down.
// It returns nil after a graceful Shutdown and an error for any other failure.
func (s *Server) Start() error {
	if err := s.httpServer.ListenAndServe(); err != nil && !errors.Is(err, http.ErrServerClosed) {
		return err
	}
	return nil
}

// Shutdown gracefully stops the server, waiting for in-flight requests to finish.
func (s *Server) Shutdown(ctx context.Context) error {
	return s.httpServer.Shutdown(ctx)
}
