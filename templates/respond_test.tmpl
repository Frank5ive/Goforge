func TestWriteJSON_EncodingFailure(t *testing.T) {
	rec := httptest.NewRecorder()

	// Channels cannot be encoded as JSON
	WriteJSON(rec, http.StatusOK, make(chan int))

	if rec.Code != http.StatusInternalServerError {
		t.Errorf("status = %d, want %d", rec.Code, http.StatusInternalServerError)
	}
}

func TestWriteError(t *testing.T) {
	rec := httptest.NewRecorder()
	rec.Header().Set(RequestIDHeader, "req-1") // set by the server's middleware

	WriteError(rec, http.StatusNotFound, "not here")

	var body ErrorResponse
	if err := json.NewDecoder(rec.Body).Decode(&body); err != nil {
		t.Fatalf("decoding body: %v", err)
	}
	if want := (ErrorResponse{Error: "not here", RequestID: "req-1"}); rec.Code != http.StatusNotFound || body != want {
		t.Errorf("got %d %+v, want 404 with %+v", rec.Code, body, want)
	}
}

func TestInternalError(t *testing.T) {
	cause := errors.New("connection refused")

	for _, development := range []bool{false, true} {
		var logs bytes.Buffer
		ctx := WithRequest(t.Context(), slog.New(slog.NewTextHandler(&logs, nil)).With("request_id", "req-1"), development)
		rec := httptest.NewRecorder()
		rec.Header().Set(RequestIDHeader, "req-1")

		InternalError(rec, httptest.NewRequestWithContext(ctx, http.MethodGet, "/orders", nil), cause)

		var body ErrorResponse
		if err := json.NewDecoder(rec.Body).Decode(&body); err != nil {
			t.Fatalf("decoding body: %v", err)
		}
		want := ErrorResponse{Error: "internal server error", RequestID: "req-1"}
		if development {
			want.Detail = cause.Error()
		}
		if rec.Code != http.StatusInternalServerError || body != want {
			t.Errorf("development=%t: got %d %+v, want 500 with %+v", development, rec.Code, body, want)
		}
		for _, logged := range []string{"connection refused", "path=/orders", "request_id=req-1"} {
			if !strings.Contains(logs.String(), logged) {
				t.Errorf("log is missing %q: %s", logged, logs.String())
			}
		}
	}
}

func TestLoggerOutsideARequest(t *testing.T) {
	if Logger(t.Context()) != slog.Default() {
		t.Error("Logger() outside a request should return slog.Default()")
	}
}

func TestDecodeJSON(t *testing.T) {
	type payload struct {
		Name string `json:"name"`
	}

	tests := []struct {
		name     string
		body     string
		maxBytes int64
		wantOK   bool
		wantCode int
	}{
		{"valid", `{"name":"gopher"}`, 1 << 20, true, http.StatusOK},
		{"malformed", `{"name":`, 1 << 20, false, http.StatusBadRequest},
		{"unknown field", `{"name":"gopher","extra":1}`, 1 << 20, false, http.StatusBadRequest},
		{"trailing data", `{"name":"a"}{"name":"b"}`, 1 << 20, false, http.StatusBadRequest},
		{"too large", `{"name":"` + strings.Repeat("x", 100) + `"}`, 16, false, http.StatusRequestEntityTooLarge},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			rec := httptest.NewRecorder()
			req := httptest.NewRequestWithContext(t.Context(), http.MethodPost, "/", strings.NewReader(tt.body))
			req.Body = http.MaxBytesReader(rec, req.Body, tt.maxBytes)

			var dst payload
			ok := DecodeJSON(rec, req, &dst)

			if ok != tt.wantOK {
				t.Fatalf("DecodeJSON() = %t, want %t (response: %s)", ok, tt.wantOK, rec.Body.String())
			}
			if rec.Code != tt.wantCode {
				t.Errorf("status = %d, want %d", rec.Code, tt.wantCode)
			}
			if ok && dst.Name != "gopher" {
				t.Errorf("decoded name = %q, want gopher", dst.Name)
			}
		})
	}
}
