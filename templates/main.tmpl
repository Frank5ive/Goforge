// Command {{.AppName}} runs the {{.AppName}} HTTP server.
package main

import (
	"context"
	"fmt"
	"log/slog"
	"os"
	"os/signal"
	"syscall"

	"{{.GetModuleName}}/config"
{{- if .IncludeLogger}}
	"{{.GetModuleName}}/logger"
{{- end}}
	"{{.GetModuleName}}/server"
)

func main() {
{{- if .IncludeLogger}}
	log := logger.New()
{{- else}}
	log := slog.Default()
{{- end}}

	if err := run(log); err != nil {
		log.Error("server error", "error", err)
		os.Exit(1)
	}
}

// run loads the configuration, starts the server, and blocks until it fails or
// receives SIGINT/SIGTERM, then shuts it down gracefully.
func run(log *slog.Logger) error {
	cfg, err := config.Load()
	if err != nil {
		return fmt.Errorf("invalid configuration: %w", err)
	}

	// Stop on Ctrl+C or SIGTERM (sent by Docker and Kubernetes)
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()

	// Shared services for the routes, such as a database pool
	var deps server.Deps
	// goforge:deps-connect (`goforge add` connects dependencies above this line)

	srv := server.New(cfg, deps, log)

	// Run the server in the background so run can wait for a shutdown signal
	serverErr := make(chan error, 1)
	go func() {
		serverErr <- srv.Start()
	}()

	log.Info("server started",
		"app", "{{.AppName}}",
		"port", cfg.Port,
		"health", fmt.Sprintf("http://localhost:%d/health", cfg.Port))

	select {
	case err := <-serverErr:
		// Start only returns before shutdown when the server could not run (e.g. port in use)
		return err
	case <-ctx.Done():
	}

	log.Info("shutting down", "timeout", cfg.ShutdownTimeout)

	shutdownCtx, cancel := context.WithTimeout(context.Background(), cfg.ShutdownTimeout)
	defer cancel()

	if err := srv.Shutdown(shutdownCtx); err != nil {
		return fmt.Errorf("graceful shutdown failed: %w", err)
	}

	log.Info("server exited gracefully")
	return nil
}
