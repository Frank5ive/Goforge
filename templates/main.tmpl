package main

import (
	"context"
	"fmt"
	"os"
	"os/signal"
	"strconv"
	"syscall"
	"time"

	"{{.GetModuleName}}/handlers"
{{- if .IncludeLogger}}
	"{{.GetModuleName}}/logger"
{{- end}}
	"{{.GetModuleName}}/server"
)

// defaultPort is used when the PORT environment variable is not set.
const defaultPort = {{.Port}}

func main() {
{{- if .IncludeLogger}}
	log := logger.New()
{{- end}}

	port, err := portFromEnv()
	if err != nil {
{{- if .IncludeLogger}}
		log.Errorf("Invalid configuration: %v", err)
{{- else}}
		fmt.Fprintf(os.Stderr, "Invalid configuration: %v\n", err)
{{- end}}
		os.Exit(1)
	}

	srv := server.New(port{{if .IncludeLogger}}, log{{end}})
	srv.RegisterRoutes(handlers.NewHealthHandler())

	// Stop on Ctrl+C or SIGTERM (sent by Docker and Kubernetes)
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()

	// Run the server in the background so main can wait for a shutdown signal
	serverErr := make(chan error, 1)
	go func() {
		serverErr <- srv.Start()
	}()

{{- if .IncludeLogger}}
	log.Infof("Starting {{.AppName}} on port %d", port)
	log.Infof("Health endpoint available at http://localhost:%d/health", port)
{{- else}}
	fmt.Printf("Starting {{.AppName}} on port %d\n", port)
	fmt.Printf("Health endpoint available at http://localhost:%d/health\n", port)
{{- end}}

	select {
	case err := <-serverErr:
		// Start only returns before Shutdown when the server could not run (e.g. port in use)
{{- if .IncludeLogger}}
		log.Errorf("Server failed: %v", err)
{{- else}}
		fmt.Fprintf(os.Stderr, "Server failed: %v\n", err)
{{- end}}
		os.Exit(1)
	case <-ctx.Done():
	}

{{- if .IncludeLogger}}
	log.Info("Shutting down server...")
{{- else}}
	fmt.Println("Shutting down server...")
{{- end}}

	// Give in-flight requests up to 30 seconds to finish
	shutdownCtx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
	defer cancel()

	if err := srv.Shutdown(shutdownCtx); err != nil {
{{- if .IncludeLogger}}
		log.Errorf("Graceful shutdown failed: %v", err)
{{- else}}
		fmt.Fprintf(os.Stderr, "Graceful shutdown failed: %v\n", err)
{{- end}}
		os.Exit(1)
	}

{{- if .IncludeLogger}}
	log.Info("Server exited gracefully")
{{- else}}
	fmt.Println("Server exited gracefully")
{{- end}}
}

// portFromEnv returns the PORT environment variable, or defaultPort if it is unset.
func portFromEnv() (int, error) {
	value := os.Getenv("PORT")
	if value == "" {
		return defaultPort, nil
	}

	port, err := strconv.Atoi(value)
	if err != nil || port < 1 || port > 65535 {
		return 0, fmt.Errorf("PORT must be a number between 1 and 65535, got %q", value)
	}
	return port, nil
}
