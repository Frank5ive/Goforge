// Package openapi serves the OpenAPI document that describes this API.
//
// The document, openapi.json, is generated by goforge from .goforge.json and
// regenerated by `goforge add resource`, so don't edit it by hand. A test in
// the server package checks that every operation it describes is registered.
package openapi

import (
	_ "embed"
	"net/http"
)

//go:embed openapi.json
var document []byte

// JSON returns the OpenAPI 3.1 document.
func JSON() []byte {
	return document
}

// Handler serves the document at GET /openapi.json.
func Handler(w http.ResponseWriter, _ *http.Request) {
	w.Header().Set("Content-Type", "application/json")
	_, _ = w.Write(document)
}
