// Package dbtest gives tests a MongoDB database.
package dbtest

import (
	"log/slog"
	"os"
	"testing"

	"go.mongodb.org/mongo-driver/v2/mongo"

	"{{.Module}}/db"
)

// Database returns the MongoDB database at TEST_DATABASE_URL, disconnected when
// the test ends. It skips the test when TEST_DATABASE_URL is unset, so
// `go test ./...` passes without a database; `make test-db` runs everything
// against MongoDB in Docker.
func Database(t testing.TB) *mongo.Database {
	t.Helper()

	uri := os.Getenv("TEST_DATABASE_URL")
	if uri == "" {
		t.Skip("TEST_DATABASE_URL is not set; skipping MongoDB tests (run `make test-db`)")
	}

	logger := slog.New(slog.DiscardHandler)
	database, err := db.Connect(t.Context(), uri, logger)
	if err != nil {
		t.Fatalf("connecting to the test database: %v", err)
	}
	t.Cleanup(func() { db.Close(database, logger) })
	return database
}
