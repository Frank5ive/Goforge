// Package dbtest gives tests a migrated PostgreSQL connection pool.
package dbtest

import (
	"log/slog"
	"os"
	"testing"

	"github.com/jackc/pgx/v5/pgxpool"

	"{{.Module}}/db"
)

// Pool returns a pool connected to TEST_DATABASE_URL with all migrations applied,
// closed when the test ends. It skips the test when TEST_DATABASE_URL is unset, so
// `go test ./...` passes without a database; `make test-db` runs everything
// against PostgreSQL in Docker.
func Pool(t testing.TB) *pgxpool.Pool {
	t.Helper()

	url := os.Getenv("TEST_DATABASE_URL")
	if url == "" {
		t.Skip("TEST_DATABASE_URL is not set; skipping PostgreSQL tests (run `make test-db`)")
	}

	pool, err := db.Connect(t.Context(), url, slog.New(slog.DiscardHandler))
	if err != nil {
		t.Fatalf("connecting to the test database: %v", err)
	}
	t.Cleanup(pool.Close)
	return pool
}
