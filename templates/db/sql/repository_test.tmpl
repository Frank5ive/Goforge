package {{.Package}}

import (
	"testing"

	"{{.Module}}/db/dbtest"
)

// Test{{.RepoType}} runs the shared repository tests against {{.EngineLabel}}.
{{- if eq .Engine "sqlite"}}
// It uses a temporary database file, or TEST_DATABASE_URL when set.
{{- else}}
// It is skipped unless TEST_DATABASE_URL is set; `make test-db` sets it.
{{- end}}
func Test{{.RepoType}}(t *testing.T) {
	database := dbtest.DB(t)

	testRepository(t, func(t *testing.T) Repository {
		if _, err := database.ExecContext(t.Context(), {{.ClearGo}}); err != nil {
			t.Fatalf("clearing the {{.TableName}} table: %v", err)
		}
		return New{{.RepoType}}(database)
	})
}
