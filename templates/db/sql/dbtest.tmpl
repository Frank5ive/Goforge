// Package dbtest gives tests a migrated {{.Label}} database.
package dbtest

import (
	"database/sql"
	"log/slog"
	"os"
{{- if eq .Engine "sqlite"}}
	"path/filepath"
{{- end}}
	"testing"

	"{{.Module}}/db"
)

{{- if eq .Engine "sqlite"}}

// DB returns a {{.Label}} database with all migrations applied, closed when the test
// ends. It uses TEST_DATABASE_URL when set, and otherwise a new database file in
// a temporary directory, so the SQLite tests always run.
func DB(t testing.TB) *sql.DB {
	t.Helper()

	url := os.Getenv("TEST_DATABASE_URL")
	if url == "" {
		url = filepath.Join(t.TempDir(), "test.db")
	}
{{- else}}

// DB returns a {{.Label}} database with all migrations applied, closed when the test
// ends. It skips the test when TEST_DATABASE_URL is unset, so `go test ./...`
// passes without a database; `make test-db` runs everything against {{.Label}}
// in Docker.
func DB(t testing.TB) *sql.DB {
	t.Helper()

	url := os.Getenv("TEST_DATABASE_URL")
	if url == "" {
		t.Skip("TEST_DATABASE_URL is not set; skipping {{.Label}} tests (run `make test-db`)")
	}
{{- end}}

	database, err := db.Connect(t.Context(), url, slog.New(slog.DiscardHandler))
	if err != nil {
		t.Fatalf("connecting to the test database: %v", err)
	}
	t.Cleanup(func() { _ = database.Close() })
	return database
}
