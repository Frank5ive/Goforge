-- Creates the table for the {{.Human}} resource (generated by `goforge add`).
{{- if eq .Engine "mysql"}}
-- MySQL commits each CREATE immediately, so this is one statement that can run
-- again if the server stopped before recording the migration.
CREATE TABLE IF NOT EXISTS {{.Table}} (
    {{.IDColumn}} {{.IDType}} PRIMARY KEY,
{{- range .Fields}}
    {{.Column}} {{.SQLType}} NOT NULL,
{{- end}}
    {{.CreatedColumn}} {{.TimeType}} NOT NULL,
    {{.UpdatedColumn}} {{.TimeType}} NOT NULL,
    -- Supports listing oldest first with stable pagination
    INDEX {{.IndexName}} ({{.CreatedColumn}}, {{.IDColumn}})
);
{{- else}}
CREATE TABLE {{.Table}} (
    {{.IDColumn}} {{.IDType}} PRIMARY KEY,
{{- range .Fields}}
    {{.Column}} {{.SQLType}} NOT NULL,
{{- end}}
    {{.CreatedColumn}} {{.TimeType}} NOT NULL,
    {{.UpdatedColumn}} {{.TimeType}} NOT NULL
);

-- Supports listing oldest first with stable pagination
CREATE INDEX {{.IndexName}} ON {{.Table}} ({{.CreatedColumn}}, {{.IDColumn}});
{{- end}}
