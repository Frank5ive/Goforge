package server

import (
	"io"
	"log/slog"
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"

	"{{.GetModuleName}}/config"
	"{{.GetModuleName}}/handlers"
)

var discardLogger = slog.New(slog.NewTextHandler(io.Discard, nil))

// testHandler returns the full handler (router and middleware) with logs discarded.
func testHandler() http.Handler {
	return newHandler(config.Config{MaxBodyBytes: 1 << 20}, Deps{}, discardLogger)
}

func TestRoutes(t *testing.T) {
	tests := []struct {
		name   string
		method string
		path   string
		want   int
	}{
		{"health", http.MethodGet, "/health", http.StatusOK},
		{"readiness", http.MethodGet, "/readyz", http.StatusOK},
		{"health HEAD", http.MethodHead, "/health", http.StatusOK},
		{"health wrong method", http.MethodPost, "/health", http.StatusMethodNotAllowed},
		{"unknown path", http.MethodGet, "/does-not-exist", http.StatusNotFound},
	}

	handler := testHandler()
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			rec := httptest.NewRecorder()
			handler.ServeHTTP(rec, httptest.NewRequestWithContext(t.Context(), tt.method, tt.path, nil))

			if rec.Code != tt.want {
				t.Errorf("%s %s = %d, want %d", tt.method, tt.path, rec.Code, tt.want)
			}
		})
	}
}

func TestRequestID(t *testing.T) {
	handler := testHandler()

	t.Run("generated when missing", func(t *testing.T) {
		rec := httptest.NewRecorder()
		handler.ServeHTTP(rec, httptest.NewRequestWithContext(t.Context(), http.MethodGet, "/health", nil))

		if id := rec.Header().Get(RequestIDHeader); len(id) != 32 {
			t.Errorf("expected a generated 32-character request ID, got %q", id)
		}
	})

	t.Run("reused when valid", func(t *testing.T) {
		rec := httptest.NewRecorder()
		req := httptest.NewRequestWithContext(t.Context(), http.MethodGet, "/health", nil)
		req.Header.Set(RequestIDHeader, "trace-123")
		handler.ServeHTTP(rec, req)

		if id := rec.Header().Get(RequestIDHeader); id != "trace-123" {
			t.Errorf("expected incoming request ID to be reused, got %q", id)
		}
	})

	t.Run("replaced when invalid", func(t *testing.T) {
		rec := httptest.NewRecorder()
		req := httptest.NewRequestWithContext(t.Context(), http.MethodGet, "/health", nil)
		req.Header.Set(RequestIDHeader, "has spaces")
		handler.ServeHTTP(rec, req)

		if id := rec.Header().Get(RequestIDHeader); id == "has spaces" {
			t.Error("expected invalid request ID to be replaced")
		}
	})
}

func TestRecovery(t *testing.T) {
	panicking := http.HandlerFunc(func(_ http.ResponseWriter, _ *http.Request) {
		panic("boom")
	})
	handler := recovery(panicking, discardLogger)

	rec := httptest.NewRecorder()
	handler.ServeHTTP(rec, httptest.NewRequestWithContext(t.Context(), http.MethodGet, "/", nil))

	if rec.Code != http.StatusInternalServerError {
		t.Errorf("status = %d, want %d", rec.Code, http.StatusInternalServerError)
	}
}

func TestCORS(t *testing.T) {
	handler := newHandler(config.Config{
		MaxBodyBytes:       1 << 20,
		CORSAllowedOrigins: []string{"https://app.example"},
	}, Deps{}, discardLogger)

	t.Run("allowed origin", func(t *testing.T) {
		rec := httptest.NewRecorder()
		req := httptest.NewRequestWithContext(t.Context(), http.MethodGet, "/health", nil)
		req.Header.Set("Origin", "https://app.example")
		handler.ServeHTTP(rec, req)

		if got := rec.Header().Get("Access-Control-Allow-Origin"); got != "https://app.example" {
			t.Errorf("Access-Control-Allow-Origin = %q, want the request origin", got)
		}
	})

	t.Run("preflight", func(t *testing.T) {
		rec := httptest.NewRecorder()
		req := httptest.NewRequestWithContext(t.Context(), http.MethodOptions, "/health", nil)
		req.Header.Set("Origin", "https://app.example")
		req.Header.Set("Access-Control-Request-Method", http.MethodPost)
		handler.ServeHTTP(rec, req)

		if rec.Code != http.StatusNoContent {
			t.Errorf("preflight status = %d, want %d", rec.Code, http.StatusNoContent)
		}
		if rec.Header().Get("Access-Control-Allow-Methods") == "" {
			t.Error("preflight response is missing Access-Control-Allow-Methods")
		}
	})

	t.Run("other origin", func(t *testing.T) {
		rec := httptest.NewRecorder()
		req := httptest.NewRequestWithContext(t.Context(), http.MethodGet, "/health", nil)
		req.Header.Set("Origin", "https://evil.example")
		handler.ServeHTTP(rec, req)

		if got := rec.Header().Get("Access-Control-Allow-Origin"); got != "" {
			t.Errorf("Access-Control-Allow-Origin = %q, want none for a disallowed origin", got)
		}
	})

	t.Run("disabled by default", func(t *testing.T) {
		rec := httptest.NewRecorder()
		req := httptest.NewRequestWithContext(t.Context(), http.MethodGet, "/health", nil)
		req.Header.Set("Origin", "https://app.example")
		testHandler().ServeHTTP(rec, req)

		if got := rec.Header().Get("Access-Control-Allow-Origin"); got != "" {
			t.Errorf("Access-Control-Allow-Origin = %q, want none when CORS is not configured", got)
		}
	})
}

func TestLimitBody(t *testing.T) {
	decode := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		var v map[string]any
		if handlers.DecodeJSON(w, r, &v) {
			w.WriteHeader(http.StatusNoContent)
		}
	})
	handler := limitBody(decode, 16)

	rec := httptest.NewRecorder()
	body := strings.NewReader(`{"name":"` + strings.Repeat("x", 100) + `"}`)
	handler.ServeHTTP(rec, httptest.NewRequestWithContext(t.Context(), http.MethodPost, "/", body))

	if rec.Code != http.StatusRequestEntityTooLarge {
		t.Errorf("status = %d, want %d", rec.Code, http.StatusRequestEntityTooLarge)
	}
}
